{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medsp1000_multiturn_generation.schema.json",
  "title": "MedSP1000 multi-turn generation attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "generation_key",
    "generation_id",
    "attempt",
    "status",
    "created_at",
    "question_id",
    "question_text",
    "private_patient_context",
    "source_scenario_path",
    "selection_reason",
    "source_dataset",
    "source_revision",
    "private_patient_context_sha256",
    "question_text_sha256",
    "patient_model",
    "patient_model_version",
    "clinician_model",
    "clinician_model_version",
    "prompt_version",
    "patient_prompt_template_id",
    "clinician_prompt_template_id",
    "exchange_count",
    "turn_count",
    "turns",
    "transcript_text",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "clinician_input_tokens",
    "clinician_output_tokens",
    "clinician_latency_ms",
    "patient_input_tokens",
    "patient_output_tokens",
    "patient_latency_ms",
    "patient_temperature",
    "clinician_temperature",
    "patient_max_output_tokens",
    "clinician_max_output_tokens",
    "seed",
    "reasoning_enabled",
    "environment_controller_used",
    "evaluator_used",
    "grading_or_judging_performed",
    "error_type",
    "error_message"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "experiment_id": { "const": "medsp1000-multiturn-generation-v1" },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "generation_key": { "$ref": "#/$defs/nonEmptyString" },
    "generation_id": { "type": "string", "pattern": "^gen-.+" },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["succeeded", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "question_id": { "$ref": "#/$defs/nonEmptyString" },
    "question_text": { "$ref": "#/$defs/nonEmptyString" },
    "private_patient_context": { "$ref": "#/$defs/nonEmptyString" },
    "source_scenario_path": { "$ref": "#/$defs/nonEmptyString" },
    "selection_reason": { "$ref": "#/$defs/nonEmptyString" },
    "source_dataset": { "const": "byrLLCC/MedSP1000" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "private_patient_context_sha256": { "$ref": "#/$defs/sha256" },
    "question_text_sha256": { "$ref": "#/$defs/sha256" },
    "patient_model": { "$ref": "#/$defs/nonEmptyString" },
    "patient_model_version": { "$ref": "#/$defs/nonEmptyString" },
    "clinician_model": { "$ref": "#/$defs/nonEmptyString" },
    "clinician_model_version": { "$ref": "#/$defs/nonEmptyString" },
    "prompt_version": { "$ref": "#/$defs/nonEmptyString" },
    "patient_prompt_template_id": { "$ref": "#/$defs/nonEmptyString" },
    "clinician_prompt_template_id": { "$ref": "#/$defs/nonEmptyString" },
    "exchange_count": { "type": "integer", "minimum": 1 },
    "turn_count": { "type": "integer", "minimum": 0 },
    "turns": {
      "type": "array",
      "items": { "$ref": "#/$defs/turn" }
    },
    "transcript_text": { "type": "string" },
    "input_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
    "output_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
    "latency_ms": { "$ref": "#/$defs/nonNegativeInteger" },
    "clinician_input_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
    "clinician_output_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
    "clinician_latency_ms": { "$ref": "#/$defs/nonNegativeInteger" },
    "patient_input_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
    "patient_output_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
    "patient_latency_ms": { "$ref": "#/$defs/nonNegativeInteger" },
    "patient_temperature": { "type": ["number", "null"] },
    "clinician_temperature": { "type": ["number", "null"] },
    "patient_max_output_tokens": { "type": "integer", "minimum": 1 },
    "clinician_max_output_tokens": { "type": "integer", "minimum": 1 },
    "seed": { "type": ["integer", "null"] },
    "reasoning_enabled": { "type": "boolean" },
    "clinician_reasoning_mode": { "$ref": "#/$defs/nonEmptyString" },
    "clinician_reasoning_effort": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "environment_controller_used": { "const": false },
    "evaluator_used": { "const": false },
    "grading_or_judging_performed": { "const": false },
    "error_type": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "turns": { "minItems": 2 },
          "transcript_text": { "minLength": 1 },
          "error_type": { "const": null },
          "error_message": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error_type": { "$ref": "#/$defs/nonEmptyString" },
          "error_message": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_index",
        "exchange_index",
        "role",
        "content",
        "model",
        "finish_reason",
        "input_tokens",
        "output_tokens",
        "latency_ms"
      ],
      "properties": {
        "turn_index": { "type": "integer", "minimum": 1 },
        "exchange_index": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["clinician", "patient"] },
        "content": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "finish_reason": { "$ref": "#/$defs/nonEmptyString" },
        "input_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "output_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "latency_ms": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    }
  }
}
